  {
    "slug": "lin-lao-shi",
    "client_name": "林老师火锅 Lin Lao Shi Hotpot",
    "industry": {
      "zh": "餐饮 · 火锅",
      "en": "F&B · Hotpot"
    },
    "services": [
      "video"
    ],
    "cover_image": "/works/lin-lao-shi/v4.jpg",
    "highlight": {
      "zh": "主打 RM50 火锅 Buffet 促销",
      "en": "Built around the RM50 buffet promo"
    },
    "summary": {
      "zh": "为林老师火锅制作 4 支餐饮短视频，主打 RM50 火锅 Buffet 促销、午餐免费续面与 PJ 分店，用食物特写与现场氛围带出「吃到饱」的价值感。",
      "en": "Four F&B short videos for Lin Lao Shi Hotpot, built around the RM50 all-you-can-eat promotion, free lunch noodle refills and the PJ outlet — using food close-ups and dining-room atmosphere to sell the value."
    },
    "challenge": {
      "zh": "",
      "en": ""
    },
    "approach": {
      "zh": "以促销价格为核心钩子（RM50 Buffet 挑战、午餐免费续面），影片长度做到 30–68 秒，留足空间展示菜色与用餐氛围，适合投放在餐饮决策前的浏览场景。",
