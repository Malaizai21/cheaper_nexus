  {
    "slug": "ace-consistent",
    "client_name": "Ace Consistent",
    "industry": {
      "zh": "贷款咨询",
      "en": "Loan Consultancy"
    },
    "services": [
      "video",
      "design",
      "ads"
    ],
    "cover_image": "/works/ace-consistent/v1.jpg",
    "highlight": {
      "zh": "痛点式开场，3 秒锁定受众",
      "en": "Pain-point hook in the first 3 seconds"
    },
    "summary": {
      "zh": "为 Ace Consistent 制作 4 支短视频与 11 张社媒广告设计，影片以「银行拒贷」的真实痛点切入，用问题式开场吸引正在申请贷款的受众。",
      "en": "Four short videos and eleven social ad designs for Ace Consistent. The videos open on a real pain point — loan rejection by banks — using a question-led hook aimed at people mid-application."
    },
    "challenge": {
      "zh": "",
      "en": ""
    },
    "approach": {
      "zh": "影片开场直接抛出受众心里的问题（「银行拒绝你，却不会告诉你原因」「不要一直申请，一直被拒」），前 3 秒就锁定目标客群；设计端做成 V2 / V3 两套版本，方便 A/B 测试不同视觉。",
      "en": "Each video opens with the question already in the viewer’s head — “the bank rejected you and never told you why” — locking in the target audience within the first three seconds. Designs were produced as two versions (V2 / V3) to A/B test visuals."
    },
    "deliverables": {
      "zh": [
        "4 支短视频（痛点式开场）",
        "11 张社媒广告设计（V2 / V3 两套版本）"
      ],
      "en": [
        "4 short videos with pain-point hooks",
        "11 social ad designs across two versions (V2 / V3)"
      ]
    },
